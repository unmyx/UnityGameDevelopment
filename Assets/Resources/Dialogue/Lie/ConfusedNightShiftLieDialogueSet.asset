%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0ca09f558f7648143a2006d5ffdc218e, type: 3}
  m_Name: ConfusedNightShiftLieDialogueSet
  m_EditorClassIdentifier: Assembly-CSharp::Game.Minigames.LieDialogueSet
  _dialogueSetId: confused_night_shift
  _suspicionPenaltyPerRepeat: 0.07
  _suspicionMinMultiplier: 0.6
  _defaultResultPassStepId: confused_pass_end
  _defaultResultFailStepId: confused_fail_end
  _defaultPostPassLine: ""
  _defaultPostFailLine: ""
  _steps:
  - _stepId: intro
    _promptText: "Uh... you are not on my checklist. Did we switch partners tonight?"
    _answers:
    - _answerId: conf_swap_east_hall
      _answerText: "Yeah, last-minute swap from east hall."
      _zoneWidthMultiplier: 1.15
      _followUpText: "No one told me, but maybe."
      _branchHook: swap_east_hall
      _nextStepId: ""
    - _answerId: conf_return_toolkit
      _answerText: "No swap, I am just returning this toolkit."
      _zoneWidthMultiplier: 1
      _followUpText: "Toolkit? Which station?"
      _branchHook: return_toolkit
      _nextStepId: ""
    - _answerId: conf_lost_after_drill
      _answerText: "Honestly, I got lost after the alarm drill."
      _zoneWidthMultiplier: 0.9
      _followUpText: "That tracks... kind of."
      _branchHook: lost_after_drill
      _nextStepId: ""
  - _stepId: confused_pass_end
    _promptText: "Okay, just sign the log before you leave this floor."
    _answers: []
  - _stepId: confused_fail_end
    _promptText: "Something is off. I am calling the lead."
    _answers: []